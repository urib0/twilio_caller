# /opt/twilio_caller/.env として配置し、パーミッションを絞ること:
#   sudo chown root:twilio /opt/twilio_caller/.env
#   sudo chmod 640 /opt/twilio_caller/.env
#
# systemd の EnvironmentFile は KEY=VALUE 形式のみ。`export` は付けない。
# 値にスペースや記号が含まれる場合はダブルクォートで囲む。

# --- Twilio 認証情報 (必須) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# 発信元 (Twilio で購入した番号。E.164 形式)
TWILIO_FROM_NUMBER=+815012345678
# 既定の宛先。schedules.toml の各エントリで to を書けば上書きできる
TWILIO_TO_NUMBER=+819012345678

# --- スケジュール定義ファイル ---
CALLER_SCHEDULE_FILE=/opt/twilio_caller/schedules.toml

# --- 読み上げ内容 ---
CALLER_MESSAGE="おはようございます。時間になりました。"
# 日本語の音声。例: Polly.Mizuki / Polly.Takumi / Google.ja-JP-Standard-B
CALLER_VOICE=Polly.Mizuki
CALLER_LANGUAGE=ja-JP
# メッセージを繰り返す回数
CALLER_SAY_REPEAT=2
# 本文の前に入れる無音の秒数 (留守電判定中に本文が流れ始めるのを防ぐ)
CALLER_LEAD_PAUSE_SECONDS=2

# --- 発信の挙動 ---
# 呼び出しを諦めるまでの秒数
CALLER_RING_TIMEOUT=40
# 1 エントリに複数の宛先がある場合の発信間隔 (秒)
CALLER_CALL_INTERVAL_SECONDS=5

# --- 留守番電話検知 (AMD) ---
# Enable / DetectMessageEnd / off
CALLER_MACHINE_DETECTION=Enable
CALLER_MACHINE_DETECTION_TIMEOUT=20
# 判定結果 (answered_by) のポーリング間隔と打ち切り秒数
CALLER_AMD_POLL_SECONDS=1
CALLER_AMD_POLL_TIMEOUT=45

# --- その他 ---
CALLER_TIMEZONE=Asia/Tokyo
CALLER_LOG_LEVEL=INFO
# 1 にすると実際には発信せず、内容をログに出すだけになる
CALLER_DRY_RUN=0
